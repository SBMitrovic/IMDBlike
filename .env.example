# EXAMPLE ENVIRONMENT FILE
# Kopiraj ovaj fajl u .env.local i popuni sa tvojim vrijednostima
# NIKADA ne commit-uj .env fajlove sa pravim vrijednostima!

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here

# TMDB (The Movie Database) API Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here

# Za lokalni development, koristi .env.local sa pravim vrijednostima
# Za Netlify, postavi ove varijable kroz Netlify Dashboard:
# Settings → Build & deploy → Environment → Environment variables
